      "reviewed_changes": [
        {
          "genus": "Emberiza",
          "decision": "accept",
          "evidence": "Accept source-specific label Emberiza buntings. All 15 AviList species are present in the current source genus; the source also contains prehistoric Emberiza alcoveri, outside this checklist. No taxonomic transfer."
        },
        {
          "genus": "Eurocephalus",
          "decision": "accept",
          "evidence": "Accept source usage White-crowned Shrikes. Both source species anguitimens and ruppelli match the existing AviList genus; German label unchanged."
        },
        {
          "genus": "Fringillaria",
          "decision": "accept",
          "evidence": "Accept African buntings as a source vernacular label. All eleven source species match the existing AviList genus; no new taxa created."
        },
        {
          "genus": "Nannus",
          "decision": "accept",
          "evidence": "Accept Holarctic wrens as a source vernacular label. All three source species match the existing AviList genus."
        },
        {
          "genus": "Pinarostola",
          "decision": "accept",
          "evidence": "Accept Drab honeyeaters for the existing Pinarostola genus only: cinerea and ixoides match both sources. No occurrence evidence transferred."
        },
        {
          "genus": "Pycnopygius",
          "decision": "accept",
          "evidence": "Remove the withdrawn English source label Drab Honeyeaters. Both sources now contain only stictocephalus. Previous immutable releases retain the historical label."
        },
        {
          "genus": "Sapayoa",
          "decision": "accept",
          "evidence": "Correct source spelling Sapoyoas to Sapayoas for the same genus ID; both sources contain only Sapayoa aenigma."
        }
      ]
    }
